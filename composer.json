{
	"name": "mediawiki/semantic-approved-revs",
	"type": "mediawiki-extension",
	"description": "Complementary extension to Semantic MediaWiki and Approved Revs to control the storage of approved revision content.",
	"keywords": [
		"SMW",
		"Semantic MediaWiki",
		"Wiki",
		"MediaWiki"
	],
	"homepage": "https://www.mediawiki.org/wiki/Extension:SemanticApprovedRevs",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "James Hong Kong",
			"homepage": "https://semantic-mediawiki.org/wiki/User:MWJames",
			"role": "Developer"
		}
	],
	"support": {
		"email": "semediawiki-user@lists.sourceforge.net",
		"issues": "https://github.com/SemanticMediaWiki/SemanticApprovedRevs/issues",
		"forum": "https://www.semantic-mediawiki.org/wiki/semantic-mediawiki.org_talk:Community_portal",
		"wiki": "https://www.semantic-mediawiki.org/wiki/",
		"source": "https://github.com/SemanticMediaWiki/SemanticApprovedRevs"
	},
	"require": {
		"php": ">=8.1",
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "48.0.2",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0.x-dev"
		}
	},
	"config": {
		"process-timeout": 0,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": [
			"@analyze",
			"@phpunit"
		],
		"test-coverage": [
			"@analyze",
			"@phpunit-coverage"
		],
		"analyze": [
			"@lint",
			"@phpcs",
			"@minus-x"
		],
		"fix": [
			"@phpcs-fix"
		],
		"phpunit": [
			"Composer\\Config::disableProcessTimeout",
			"cd ${MW_INSTALL_PATH:-../..} && if [ -f tests/phpunit/phpunit.php ]; then R='php tests/phpunit/phpunit.php'; else R='vendor/bin/phpunit --bootstrap tests/phpunit/bootstrap.php'; { [ -f tests/phpunit/generatePHPUnitConfig.php ] && { php tests/phpunit/generatePHPUnitConfig.php >/dev/null 2>&1 || true; [ -f phpunit.xml ] || printf '%s' '<phpunit><!-- generatePHPUnitConfig --></phpunit>' > phpunit.xml; } || true; }; fi && MEDIAWIKI_HAS_INTEGRATION_TESTS=1 $R -c extensions/SemanticApprovedRevs/phpunit.xml.dist"
		],
		"phpunit-coverage": "@phpunit --testdox --coverage-text --coverage-html extensions/SemanticApprovedRevs/coverage/php --coverage-clover extensions/SemanticApprovedRevs/coverage/php/coverage.xml",
		"post-test-coverage": [
			"sed -i 's|/var/www/html/extensions/SemanticApprovedRevs/||g' coverage/php/coverage.xml",
			"find coverage/php -type f -name '*.html' -exec sed -i 's|/var/www/html/extensions/||g' {} +"
		],
		"phan": "phan --allow-polyfill-parser",
		"phpcs": "phpcs -ps -d memory_limit=2G",
		"phpcs-fix": "phpcbf -p",
		"lint": "parallel-lint . --exclude vendor --exclude node_modules --exclude extensions",
		"minus-x": "minus-x check ."
	}
}
